{
  "name": "@paceline/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "PACELINE_STORE=1 wxt zip",
    "test": "vitest run",
    "typecheck": "wxt prepare && tsc --noEmit -p .",
    "e2e": "wxt build && playwright test",
    "screenshots": "wxt build && playwright test --config playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@paceline/shared": "workspace:*",
    "canvas-confetti": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wxt": "0.21.4"
  }
}
