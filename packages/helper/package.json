  },
  "devDependencies": {
    "@paceline/shared": "workspace:*",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  }
}
